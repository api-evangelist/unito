        {
          "id": "db905a33-76bd-4fd0-a5bc-82e8a46d01a7",
          "name": "Create or replace a workspace",
          "request": {
            "name": "Create or replace a workspace",
            "description": {
              "content": "Create or replace a workspace to control its access by users and provide metadata about the workspace to Unito.\nIf there is no matching workspace, one will be created. If a matching workspace exists, it will be replaced. Therefore it is important to always provide the full set of properties and metadata on each call.\nIt is possible to create workspaces using this endpoint before any user accesses the workspace through an embed. Until the workspace is first accessed by a user, the workspace will not be returned by any usage reports endpoints.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "embeds",
                ":embedId",
                "workspaces",
                ":externalWorkspaceId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "embedId",
                  "description": "(Required) The identifier of the embed"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "externalWorkspaceId",
                  "description": "(Required) A native unique identifier for the account, organization or group that the user accessing the embed belongs to. Must match the workspace_id_ext passed in the iframe URL"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"externalStatus\": \"<string>\",\n  \"externalData\": {\n    \"key_0\": true,\n    \"key_1\": \"string\",\n    \"key_2\": \"string\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
