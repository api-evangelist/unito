{
  "opencollection": "1.0.0",
  "info": {
    "name": "Unito Embed Reports API",
    "version": "0.1.4"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Reports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a full usage report on your flows",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:9080/embeds/:embedId/reports/:reportType",
            "params": [
              {
                "name": "pagination",
                "value": "",
                "type": "query",
                "description": "Details to paginate the results."
              },
              {
                "name": "embedId",
                "value": "",
                "type": "path",
                "description": "The identifier of the embed"
              },
              {
                "name": "reportType",
                "value": "",
                "type": "path",
                "description": "The identifier of the embed"
              }
            ]
          },
          "docs": "Return a complete usage report for each individual flow created within all workspaces of your embed.\nWorkspaces with a status of \"disabled\" are excluded.\nData is refreshed every few hours, at most every 24h.\n"
        }
      ]
    }
  ],
  "bundled": true
}